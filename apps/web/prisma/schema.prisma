  terms     terms    @relation(fields: [terms_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_terms_agreement_terms")
  user      user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_terms_agreement_user")

  @@unique([user_id, terms_id], map: "ux_terms_agreement_user_terms")
}

