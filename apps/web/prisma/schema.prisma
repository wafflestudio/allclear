/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model club_recruitment {
  id                     BigInt    @id @default(autoincrement())
  club_id                String    @db.Uuid
  title                  String    @default("") @db.VarChar
  deadline               DateTime  @db.Timestamptz(6)
  is_mandatory           Boolean   @default(false)
  has_regular_meeting    Boolean   @default(false)
  activity_location_type String    @default("미정") @db.VarChar
  activity_location_text String    @default("") @db.VarChar
  has_eligibility        Boolean   @default(false)
  eligibility_text       String    @default("") @db.VarChar
  has_capacity_limit     Boolean   @default(false)
  capacity_limit_text    String    @default("") @db.VarChar
  has_membership_fee     Boolean   @default(false)
  membership_fee_text    String    @default("") @db.VarChar
  application_url        String    @default("") @db.VarChar
  application_process    String    @default("") @db.VarChar
  full_recruitment_text  String?   @db.VarChar
  image_urls             Json?     @default("[]")
  year_month             String    @db.VarChar
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at             DateTime? @db.Timestamptz(6)

  @@unique([club_id, year_month], map: "idx_unique_club_month_active", where: raw("(deleted_at IS NULL)"))
  @@index([club_id, updated_at(sort: Desc)], map: "idx_club_recruitment_club_updated", where: raw("(deleted_at IS NULL)"))
  @@index([club_id, deadline], map: "idx_recruitment_active_by_club_deadline", where: raw("(deleted_at IS NULL)"))
  @@index([club_id], map: "idx_recruitment_club_id")
  @@index([deadline], map: "idx_recruitment_deadline")
  @@index([club_id, year_month(sort: Desc), created_at(sort: Desc)], map: "idx_recruitment_latest_by_club", where: raw("(deleted_at IS NULL)"))
  @@index([club_id, has_membership_fee], map: "idx_recruitment_membership_fee_by_club", where: raw("(deleted_at IS NULL)"))
}

