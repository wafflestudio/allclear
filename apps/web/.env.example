# Copy this file to .env.local for local development.
# Never commit real credentials or production values.

# Application
HOST=http://localhost:3000
MAINTENANCE_MODE=false
APP_VERSION_POLICY_API_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=postgres

# Redis (the application adds the redis:// protocol)
REDIS_URL=localhost:6379

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Authentication
JWT_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Discord
DISCORD_WEBHOOK_URL_USER_VOICE=
