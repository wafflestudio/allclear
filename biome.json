{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"root": ".",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{js,jsx,ts,tsx,json,jsonc}",
			"!**/android",
			"!**/ios",
			"!**/vendor",
			"!**/.history",
			"!**/.bundle-check",
			"!**/.claude",
			"!**/app.json"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"globals": ["__DEV__"]
	},
	"overrides": [
		{
			"includes": ["apps/web/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noStaticElementInteractions": "off",
						"noSvgWithoutTitle": "off",
						"useButtonType": "off",
						"useKeyWithClickEvents": "off",
						"useSemanticElements": "off",
						"useValidAnchor": "off"
					},
					"complexity": {
						"noStaticOnlyClass": "off",
						"noUselessFragments": "off",
						"useDateNow": "off",
						"useLiteralKeys": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "off",
						"noUnusedImports": "off",
						"noUnusedPrivateClassMembers": "off",
						"noUnusedVariables": "off",
						"useExhaustiveDependencies": "off",
						"useJsxKeyInIterable": "off"
					},
					"performance": {
						"noImgElement": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					},
					"style": {
						"noNonNullAssertion": "off",
						"useNodejsImportProtocol": "off",
						"useTemplate": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDoubleEquals": "off",
						"noExplicitAny": "off",
						"noFocusedTests": "off",
						"noShadowRestrictedNames": "off"
					}
				}
			},
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2,
				"lineWidth": 100
			},
			"javascript": {
				"formatter": {
					"quoteStyle": "single",
					"semicolons": "asNeeded"
				}
			}
		},
		{
			"includes": ["apps/web/server/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["src/**", "**/src/**"],
										"message": "server는 src를 import할 수 없습니다. 서버가 소유하는 타입과 상수는 server/domain에, HTTP 계약은 server/http/schemas에 두세요."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"server/provider",
											"server/{service,provider,infra}/**",
											"**/server/provider",
											"**/server/{service,provider,infra}/**"
										],
										"message": "src는 server/service, server/provider, server/infra를 직접 import할 수 없습니다. 서버 호출은 pages/api를 거치고, 타입은 server/domain과 server/http/schemas에서 import type으로 가져오세요."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
