{
	"name": "allclear",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"start": "pnpm --dir apps/mobile run start",
		"dev:web": "pnpm --dir apps/web run dev",
		"ios": "pnpm --dir apps/mobile run ios",
		"ios:local": "pnpm --dir apps/mobile run ios:local",
		"ios:prod": "pnpm --dir apps/mobile run ios:prod",
		"android:debug": "pnpm --dir apps/mobile run android:debug",
		"android:release": "pnpm --dir apps/mobile run android:release",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"verify": "turbo run lint typecheck test",
		"verify:full": "pnpm --dir apps/mobile run verify:full",
		"fix": "pnpm --dir apps/mobile run fix"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"turbo": "^2.10.8"
	},
	"dependencies": {
		"@babel/runtime": "^7.29.7"
	}
}
