/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model announcement {
  id                   Int                    @id @default(autoincrement())
  uuid                 String                 @unique(map: "ux_announcement_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                String                 @db.VarChar(255)
  content              String
  start_at             DateTime               @db.Timestamp(6)
  end_at               DateTime?              @db.Timestamp(6)
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  updated_at           DateTime               @default(now()) @db.Timestamp(6)
  active               Boolean                @default(false)
  announcement_dismiss announcement_dismiss[]
}

model announcement_dismiss {
  id              Int          @id @default(autoincrement())
  announcement_id Int
  user_id         String       @db.Uuid
  dismissed_at    DateTime     @default(now()) @db.Timestamp(6)
  announcement    announcement @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_announcement_dismiss_announcement")
  user            user         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_announcement_dismiss_user")

  @@unique([announcement_id, user_id], map: "ux_announcement_dismiss_announcement_user")
  @@index([user_id], map: "ix_announcement_dismiss_user_id")
}

