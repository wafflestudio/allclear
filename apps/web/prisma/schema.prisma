model terms {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique(map: "ux_terms_uuid") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String            @db.VarChar(255)
  content_url     String            @db.VarChar(255)
  version         String            @db.VarChar(32)
  is_mandatory    Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  active          Boolean           @default(false)
  terms_key       String            @unique(map: "unique_active_terms_per_key", where: raw("(active = true)")) @db.VarChar(64)
  terms_agreement terms_agreement[]

  @@unique([terms_key, version], map: "ux_terms_key_version")
}

model terms_agreement {
  id        Int      @id @default(autoincrement())
  user_id   String   @db.Uuid
